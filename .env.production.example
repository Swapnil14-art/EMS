# Copy to .env.production and replace every secret before deploying.
APP_ENV=production
DEBUG=false
APP_SECRET_KEY=replace-with-a-unique-long-secret
JWT_SECRET=replace-with-a-unique-long-secret
JWT_REFRESH_SECRET=replace-with-a-different-unique-long-secret
FRONTEND_URL=https://ems.example.edu
DATABASE_URL=postgresql+asyncpg://ems_user:replace-password@db:5432/ems_db
DATABASE_URL_SYNC=postgresql://ems_user:replace-password@db:5432/ems_db
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=replace-password
POSTGRES_DB=ems_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_username
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM=your_verified_brevo_sender_email
SMTP_FROM_NAME=EMS
SMTP_TLS=true
STORAGE_ROOT=/app/storage
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
