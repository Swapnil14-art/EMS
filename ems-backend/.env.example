# App
APP_ENV=development
APP_SECRET_KEY=your-random-256-bit-secret
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://ems_user:ems_pass@db:5433/ems_db
DATABASE_URL_SYNC=postgresql://ems_user:ems_pass@db:5433/ems_db

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Microsoft Azure AD (Entra ID)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# Allowed email domains
ALLOWED_DOMAINS=nmims.in,nmims.edu

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_username
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM=your_verified_brevo_sender_email
SMTP_FROM_NAME=EMS
SMTP_TLS=true

# Storage
STORAGE_ROOT=/app/storage

# Frontend (CORS)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# College
COLLEGE_NAME=SVKM's NMIMS, Shirpur Campus

# Legal & Privacy Compliance (Configure per institution)
LEGAL_ENTITY_NAME=[Operating Institution: SVKM's NMIMS, Shirpur Campus]
PRIVACY_OFFICER_NAME=[Designated Privacy Officer / Coordinator]
PRIVACY_OFFICER_EMAIL=privacy@shirpur.nmims.edu
GRIEVANCE_OFFICER_NAME=[Designated Grievance Redressal Officer]
GRIEVANCE_OFFICER_EMAIL=grievance-ems@shirpur.nmims.edu
GRIEVANCE_OFFICER_ADDRESS=[Campus Address: SVKM's NMIMS, Mukesh Patel Technology Park, Babulde, Bank of Tapi River, Mumbai-Agra National Highway 3, Shirpur, Dhule, Maharashtra 425405, India]
CURRENT_TERMS_VERSION=1.0
CURRENT_PRIVACY_VERSION=1.0
CURRENT_COOKIE_VERSION=1.0
