# ── FRONTEND (Next.js) PRODUCTION ──────────────────────────────────────────────
# These are injected at build-time. For OCI, replace with your Public IP or Domain.

# Example: http://123.45.67.89/api/v1 or https://ems.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://YOUR_OCI_PUBLIC_IP/api/v1

NEXT_PUBLIC_APP_NAME=EMS
NEXT_PUBLIC_COLLEGE_NAME="NMIMS Shirpur"

# If using OCI Object Storage for direct client-side uploads (optional)
# NEXT_PUBLIC_OCI_STORAGE_URL=https://objectstorage.ap-hyderabad-1.oraclecloud.com/n/YOUR_NAMESPACE/b/YOUR_BUCKET/o/
