# ─────────────────────────────────────────────────────────────────────────────
# EMS .env.example — Copy to .env and fill in all values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE (Neon PostgreSQL) ─────────────────────────────────────────────
# Get this from https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql+asyncpg://username:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your-super-secret-key-here-at-least-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── REDIS ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── OCI OBJECT STORAGE ─────────────────────────────────────────────────────
# From OCI Console → Identity → Users → your user → Customer Secret Keys
OCI_ACCESS_KEY=your-oci-access-key
OCI_SECRET_KEY=your-oci-secret-key
OCI_NAMESPACE=your-tenancy-namespace
OCI_REGION=ap-singapore-1
OCI_BUCKET_NAME=ems-uploads
# Use 'dev' for development, 'prod' for production
OCI_STORAGE_PREFIX=dev

# ── EMAIL (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.nmims.in
SMTP_PORT=587
SMTP_USER=noreply@nmims.in
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@nmims.in
EMAIL_FROM_NAME=NMIMS EMS

# ── APPLICATION ─────────────────────────────────────────────────────────────
ENV=development
ALLOWED_EMAIL_DOMAIN=@nmims.in
CORS_ORIGINS=http://localhost:3000,http://localhost

# ── FRONTEND (Next.js) ──────────────────────────────────────────────────────
# These are injected at build time (NEXT_PUBLIC_ prefix = client-visible)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_NAME=EMS
NEXT_PUBLIC_COLLEGE_NAME=NMIMS Shirpur
